<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- گرادیان پس‌زمینه تیره -->
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#111827" />
      <stop offset="100%" stop-color="#050505" />
    </linearGradient>
    
    <!-- افکت درخشش آبی -->
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- پس‌زمینه با گوشه‌های گرد مشابه تصویر قبلی -->
  <rect x="24" y="24" width="464" height="464" rx="100" fill="url(#bgGradient)" />

  <!-- لایه‌های کره زمین -->
  <g stroke="#3b82f6" stroke-width="14" fill="none" filter="url(#neonGlow)">
    <!-- دایره بیرونی زمین -->
    <circle cx="256" cy="256" r="160" />
    
    <!-- خطوط استوا و نصف‌النهار (حالت سه‌بعدی) -->
    <ellipse cx="256" cy="256" rx="160" ry="55" />
    <ellipse cx="256" cy="256" rx="55" ry="160" />
  </g>

  <!-- نوشته MH در مرکز با حاشیه تیره برای خوانایی بهتر -->
  <text 
    x="256" 
    y="295" 
    font-family="'Segoe UI', system-ui, sans-serif" 
    font-size="120" 
    font-weight="900" 
    fill="#ffffff" 
    text-anchor="middle" 
    stroke="#050505" 
    stroke-width="12" 
    letter-spacing="2">
    mh
  </text>
  
  <!-- لایه درخشان روی متن برای جذابیت بیشتر -->
  <text 
    x="256" 
    y="295" 
    font-family="'Segoe UI', system-ui, sans-serif" 
    font-size="120" 
    font-weight="900" 
    fill="#ffffff" 
    text-anchor="middle" 
    letter-spacing="2">
    mh
  </text>
</svg>
